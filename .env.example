# Ruhama environment variables
# Copy to `.env` for local development (`cp .env.example .env`) and fill in the values.
# On Vercel, add the same keys under Project Settings > Environment Variables.
# Never commit real secrets. Variables starting with NEXT_PUBLIC_ are sent to the browser, so only
# public values (site keys, URLs, the Supabase anon key) may use that prefix.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Public base URL, no trailing slash. Used for canonical links, sitemaps, OG images, auth callbacks
# and links in emails. Production: https://your-domain. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------

# Pooled connection used by the app at runtime (serverless friendly).
# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
# Local: postgres://postgres:postgres@localhost:5432/ruhama
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ruhama

# Session-mode connection, used only for migrations (`npm run migrate`).
# Supabase: Connect > "Session pooler" (same pooler host, port 5432). Not "Direct connection": that
# host is IPv6-only and unreachable from many networks and from Vercel. Leave empty locally to reuse
# DATABASE_URL. Use letters and digits in the database password, or URL-encode it (/ becomes %2F).
DATABASE_URL_DIRECT=

# Optional. Connections per app instance. Defaults to 3 on Vercel and during builds, 10 elsewhere.
DATABASE_POOL_MAX=

# ---------------------------------------------------------------------------
# Secrets (required)
# ---------------------------------------------------------------------------

# Payload CMS secret, at least 16 characters. Generate: openssl rand -base64 32
PAYLOAD_SECRET=

# Better Auth secret that signs sessions, at least 16 characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Bearer token Vercel Cron sends to /api/v1/cron/daily (event reminders, purging deleted accounts,
# housekeeping) and /api/v1/cron/refresh (date-dependent pages at Bangladesh midnight).
# Generate: openssl rand -hex 32. Vercel sends it automatically once set.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Sign-in providers (optional: each button appears only when both values are set)
# ---------------------------------------------------------------------------

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type
# "Web application"). Authorised redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login app (developers.facebook.com > My Apps > Facebook Login > Settings).
# Valid OAuth redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Extra origins allowed to call the auth API, comma separated (for example Vercel preview URLs or a
# local production run on another port). The site URL is always allowed.
BETTER_AUTH_TRUSTED_ORIGINS=

# Deep-link scheme for a future mobile app (used in auth redirects). Default: ruhama
MOBILE_APP_SCHEME=ruhama

# ---------------------------------------------------------------------------
# Bot protection (Cloudflare Turnstile)
# ---------------------------------------------------------------------------

# Cloudflare dashboard > Turnstile > Add site (widget mode "Managed"). Protects registration, OTP
# requests, guest event registration and the contact form.
# Locally both may stay empty: Cloudflare's always-pass test keys are used outside production.
# In production they are required: without the secret those forms are refused (fail closed).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Phone login (SMS one-time codes)
# ---------------------------------------------------------------------------

# "console" prints messages locally (or writes them to OUTBOX_DIR). "bd_gateway" sends through a
# Bangladeshi bulk-SMS HTTP API. In production without a working gateway no code is sent or logged.
SMS_PROVIDER=console
# Gateway endpoint, API key and approved sender ID from your SMS provider (BulkSMSBD-style API).
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------

# resend.com > API Keys. Without it, emails are written to OUTBOX_DIR or printed locally; in
# production they fail visibly instead.
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
EMAIL_FROM=Ruhama <noreply@ruhama.org>
# Optional Reply-To for transactional emails.
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Media storage (Cloudflare R2 through Payload's S3 adapter)
# ---------------------------------------------------------------------------

# Cloudflare dashboard > R2 > Create bucket, then "Manage R2 API tokens" (Object Read & Write on the
# bucket). Endpoint: https://<account-id>.r2.cloudflarestorage.com
# Without these, uploads are stored on the local disk (fine for development only).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public custom domain connected to the bucket (R2 > bucket > Settings > Custom Domains),
# for example https://media.your-domain. Media URLs are built from it.
NEXT_PUBLIC_MEDIA_URL=
# Set to "cloudflare" to resize and convert images at the edge (/cdn-cgi/image/...) instead of using
# Vercel's image optimizer, which has a monthly limit on the free plan. First enable it in Cloudflare:
# your domain > Images > Transformations > Enable for zone (5,000 unique transformations a month free).
# Left empty, images are served at their original size.
NEXT_PUBLIC_IMAGE_TRANSFORMS=

# ---------------------------------------------------------------------------
# Live updates (Supabase Realtime Broadcast)
# ---------------------------------------------------------------------------

# Supabase: Project Settings > API. The URL and anon key are public; the service role key is a
# secret and is only used on the server to broadcast. Without them, pages poll for updates instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# Which request header holds the real client IP (used for rate limits). Leave empty on Vercel, which
# sets x-real-ip / x-forwarded-for itself. Behind Cloudflare's proxy use: cf-connecting-ip
TRUSTED_IP_HEADER=

# ---------------------------------------------------------------------------
# Development and tests
# ---------------------------------------------------------------------------

# Folder where emails and SMS are written as JSON lines instead of being sent (the end-to-end tests
# read verification links and OTP codes from here). Leave empty in production.
OUTBOX_DIR=.outbox

# Password for every account created by `npm run seed`. Default: Ruhama@2026
SEED_PASSWORD=

# Base URL the Playwright tests run against. Default: http://localhost:3000
E2E_BASE_URL=
