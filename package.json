{
  "name": "ruhama",
  "version": "1.0.0",
  "private": true,
  "description": "Ruhama: an Islamic unity and knowledge platform for Bangladeshi Muslims",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build && serwist build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "vercel-build": "node scripts/vercel-build.mjs",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "format": "prettier --write .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed.ts",
    "import:quran": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import-quran.ts",
    "import:hadith": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import-hadith.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/core": "1.7.7",
    "@better-auth/expo": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@expo-google-fonts/noto-serif-bengali": "0.4.4",
    "@hookform/resolvers": "^5.2.2",
    "@marsidev/react-turnstile": "^1.6.1",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@serwist/next": "9.5.13",
    "@supabase/realtime-js": "^2.117.2",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "payload": "3.90.2",
    "payload-auth": "3.0.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "resend": "^6.32.0",
    "server-only": "^0.0.1",
    "serwist": "9.5.13",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.63.0",
    "@serwist/cli": "^9.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.9",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "^28.0.0",
    "patch-package": "^8.0.1",
    "pg": "8.20.0",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
